# Build output
/bin/
coverage.out

# The annotated coverage report is generated with every evidence run and kept
# locally, but not committed. GitHub does not render a checked-in HTML file, so
# its only value is on the machine that produced it — and at ~450KB it would
# otherwise be the largest thing in the repository, twice over.
evidence/**/*.html

# Stray binaries from 'go build ./cmd/x' without -o, which drops the executable
# in the working directory and is easy to commit by accident.
/gatewaysvc
/identitysvc
/productsvc
/cartsvc
/ordersvc
/notificationsvc
/ccasvc
/warehousesvc
/kvnode
/productloader
/healthcheck

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log

# Python
__pycache__/
.venv/
*.pyc

# Editors and OS
.DS_Store
.idea/
.vscode/
